{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    // Off, and only this one. The server reads `error?.code` and
    // `error?.message` off whatever Node hands it, in every catch it has;
    // turning this on would mean an `instanceof` dance at each of them to
    // learn nothing. The one place the distinction carries weight — whether a
    // refusal was raised on purpose and may be shown to the caller — asks
    // `deliberateStatus`, which narrows properly.
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  // The tests are left out. They are checked by being run — 1786 of them —
  // and pulling them in adds 111 errors about vitest's globals that say
  // nothing about whether the server is right.
  "include": ["server/*.mjs", "scripts/*.mjs"],
  "exclude": ["server/*.test.mjs"]
}
